<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wang Koo — Designer</title>
  <meta name="description" content="Wang Koo is a designer from Indonesia crafting brands, interfaces and 3D worlds.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">
</head>
<body>
  <nav class="nav glass" aria-label="Main">
    <a class="nav__logo" href="#hero"><b>WANG</b> <span>KOO</span></a>
    <ul class="nav__links">
      <li><a href="#about">About</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#testimonials">Words</a></li>
    </ul>
    <a class="btn btn--light btn--sm" href="#contact">Contact</a>
  </nav>

  <main>
    <section class="hero" id="hero">
      <canvas class="hero__canvas" id="heroCanvas" aria-hidden="true"></canvas>
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="hero__content container">
        <div class="hero__main">
          <span class="chip glass"><span class="dot"></span>Available for projects, 2026</span>
          <h1 class="hero__title">WANG<br>KOO</h1>
          <p class="hero__intro">Designer from Indonesia crafting brands, interfaces and playful 3D worlds.</p>
          <div class="hero__actions">
            <a class="btn btn--light" href="#contact">Get in touch <span class="btn__arrow" aria-hidden="true">→</span></a>
            <a class="btn glass" href="#work">View work</a>
          </div>
        </div>

        <aside class="hero__stats">
          <div class="stat glass">
            <span class="stat__value">08+</span>
            <span class="stat__label">Years designing</span>
          </div>
          <div class="stat glass">
            <span class="stat__value">120</span>
            <span class="stat__label">Projects shipped</span>
          </div>
          <div class="stat glass">
            <span class="stat__label">Based in</span>
            <span class="stat__value stat__value--sm">JAKARTA, ID</span>
            <span class="stat__time" id="jakartaTime">--:-- WIB</span>
          </div>
        </aside>
      </div>

      <a class="hero__scroll glass" href="#about" aria-label="Scroll to About">
        <span class="hero__scroll-dot"></span>
      </a>

      <div class="loader" id="loader">
        <div class="loader__pill glass">
          <span class="loader__label">LOADING</span>
          <span class="loader__bar" role="progressbar" aria-label="Loading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="loader__fill" id="loaderFill"></span>
          </span>
          <span class="loader__pct" id="loaderPct">0%</span>
        </div>
      </div>
    </section>

    <section class="about" id="about">
      <div class="marquee" aria-label="Brand Identity, UI / UX, 3D Design, Motion. Wang Koo, Designer, Indonesia, since 2018.">
        <div class="marquee__row" aria-hidden="true">
          <div class="marquee__track">
            <div class="marquee__group">
              <span>Brand Identity</span><span class="marquee__sep">✦</span>
              <span class="outline">UI / UX</span><span class="marquee__sep">✦</span>
              <span>3D Design</span><span class="marquee__sep">✦</span>
              <span class="outline">Motion</span><span class="marquee__sep">✦</span>
            </div>
          </div>
        </div>
        <div class="marquee__row marquee--reverse" aria-hidden="true">
          <div class="marquee__track">
            <div class="marquee__group">
              <span>Wang Koo</span><span class="marquee__sep">✦</span>
              <span class="outline">Designer</span><span class="marquee__sep">✦</span>
              <span>Indonesia</span><span class="marquee__sep">✦</span>
              <span class="outline">Since 2018</span><span class="marquee__sep">✦</span>
            </div>
          </div>
        </div>
      </div>

      <div class="about__body container">
        <p class="eyebrow">(01) About</p>
        <p class="about__text">
          I'm Wang Koo, a multidisciplinary designer working out of Jakarta. I build
          <strong>identities people remember</strong>, interfaces that feel effortless and 3D
          scenes with a sense of play, for studios and startups across Asia and beyond.
        </p>
        <ul class="about__tags">
          <li class="tag">Branding</li>
          <li class="tag">Product Design</li>
          <li class="tag">Blender / C4D</li>
          <li class="tag">Figma</li>
          <li class="tag">Art Direction</li>
        </ul>
      </div>
    </section>

    <section class="work" id="work" data-nav="light">
      <div class="work__sticky">
        <div class="work__head container">
          <p class="eyebrow">(02) Selected Work</p>
          <p class="work__counter"><span id="workCurrent">01</span> / 05</p>
        </div>

        <div class="work__track" id="workTrack">
          <div class="work__intro">
            <h2 class="work__title">Selected<br>Projects</h2>
            <p>Scroll to explore a few favourites from the last couple of years.</p>
          </div>

          <article class="project project--kopi">
            <div class="project__art"></div>
            <span class="project__num">01</span>
            <div class="project__info glass">
              <div>
                <h3 class="project__title">Kopi Senja</h3>
                <p class="project__cat">Brand identity · Packaging</p>
              </div>
              <span class="project__year">2025</span>
            </div>
          </article>

          <article class="project project--lumen">
            <div class="project__art"></div>
            <span class="project__num">02</span>
            <div class="project__info glass">
              <div>
                <h3 class="project__title">Lumen Bank</h3>
                <p class="project__cat">Mobile app · UI / UX</p>
              </div>
              <span class="project__year">2025</span>
            </div>
          </article>

          <article class="project project--pixel">
            <div class="project__art"></div>
            <span class="project__num">03</span>
            <div class="project__info glass">
              <div>
                <h3 class="project__title">Pixel Pals</h3>
                <p class="project__cat">3D characters · Motion</p>
              </div>
              <span class="project__year">2024</span>
            </div>
          </article>

          <article class="project project--batik">
            <div class="project__art"></div>
            <span class="project__num">04</span>
            <div class="project__info glass">
              <div>
                <h3 class="project__title">Batik Now</h3>
                <p class="project__cat">Editorial · Art direction</p>
              </div>
              <span class="project__year">2024</span>
            </div>
          </article>

          <article class="project project--orbit">
            <div class="project__art"></div>
            <span class="project__num">05</span>
            <div class="project__info glass">
              <div>
                <h3 class="project__title">Orbit OS</h3>
                <p class="project__cat">Product design · Web</p>
              </div>
              <span class="project__year">2023</span>
            </div>
          </article>
        </div>

        <div class="work__progress" aria-hidden="true"><span id="workProgress"></span></div>
      </div>
    </section>

    <section class="testimonials" id="testimonials">
      <div class="blob blob--pink" aria-hidden="true"></div>
      <div class="blob blob--blue" aria-hidden="true"></div>

      <div class="testimonials__inner container">
        <p class="eyebrow">(03) Kind Words</p>
        <h2 class="testimonials__title">What clients say</h2>

        <!-- Placeholder quotes: replace with real ones before launch. -->
        <div class="quotes">
          <figure class="quote glass">
            <blockquote>
              “Wang turned a tiny coffee cart into a brand people line up for. Every
              touchpoint, from cups to signage, suddenly felt like us.”
            </blockquote>
            <figcaption class="quote__author">
              <span class="quote__avatar" aria-hidden="true">AS</span>
              <span>
                <span class="quote__name">Ayu Setiawan</span>
                <span class="quote__role">Founder, Kopi Senja</span>
              </span>
            </figcaption>
          </figure>

          <figure class="quote glass">
            <blockquote>
              “Rare mix of craft and clarity. Our app went from confusing to calm, and
              the design system Wang left behind still saves us weeks.”
            </blockquote>
            <figcaption class="quote__author">
              <span class="quote__avatar" aria-hidden="true">DL</span>
              <span>
                <span class="quote__name">Daniel Lim</span>
                <span class="quote__role">Head of Product, Lumen</span>
              </span>
            </figcaption>
          </figure>

          <figure class="quote glass">
            <blockquote>
              “The 3D work gave our launch a personality we couldn't have found on our
              own. Playful, precise and delivered ahead of schedule.”
            </blockquote>
            <figcaption class="quote__author">
              <span class="quote__avatar" aria-hidden="true">MR</span>
              <span>
                <span class="quote__name">Maya Rahman</span>
                <span class="quote__role">Creative Lead, Orbit</span>
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer" id="contact" data-nav="light">
    <div class="container">
      <p class="eyebrow">(04) Contact</p>
      <h2 class="footer__title">Let's make<br>something <span class="outline">great</span></h2>
      <a class="btn btn--dark btn--lg" href="mailto:hello@wangkoo.design">
        hello@wangkoo.design <span class="btn__arrow" aria-hidden="true">→</span>
      </a>

      <div class="footer__grid">
        <div>
          <h3 class="footer__heading">Studio</h3>
          <p>Jakarta, Indonesia<br>Working worldwide</p>
        </div>
        <div>
          <h3 class="footer__heading">Social</h3>
          <ul class="footer__list">
            <li><a href="#">Instagram</a></li>
            <li><a href="#">Dribbble</a></li>
            <li><a href="#">Behance</a></li>
            <li><a href="#">LinkedIn</a></li>
          </ul>
        </div>
        <div>
          <h3 class="footer__heading">Menu</h3>
          <ul class="footer__list">
            <li><a href="#about">About</a></li>
            <li><a href="#work">Work</a></li>
            <li><a href="#testimonials">Words</a></li>
          </ul>
        </div>
        <div class="footer__top-wrap">
          <a class="footer__top glass" href="#hero" aria-label="Back to top">↑</a>
        </div>
      </div>

      <div class="footer__bottom">
        <span>© 2026 Wang Koo</span>
        <span>Designed in Indonesia</span>
      </div>
    </div>

    <div class="footer__wordmark" aria-hidden="true">WANG KOO</div>
  </footer>

  <div class="trail" id="trail" aria-hidden="true"></div>

  <script src="script.js"></script>
</body>
</html>
